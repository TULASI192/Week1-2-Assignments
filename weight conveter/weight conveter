import java.util.Scanner;

public class WeightConverter {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        // Prompt the user for input
        System.out.print("Enter weight in pounds (lbs): ");
        
        // Read the input weight
        if (scanner.hasNextDouble()) {
            double weightInPounds = scanner.nextDouble();

            // Calculate the weight in kilograms
            double weightInKilograms = weightInPounds / 2.2;

            // Display the result
            System.out.printf("The weight of the person in pound is %.2f and in kg is %.2f%n", weightInPounds, weightInKilograms);
        } else {
            System.out.println("Invalid input. Please enter a numerical value.");
        }

        // Close the scanner
        scanner.close();
    }
}